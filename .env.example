# Copy to .env and fill in. .env is git-ignored. Every EXPO_PUBLIC_* value is
# bundled into the app, so never put a secret here (the Supabase anon key is
# public by design; the service_role key must never appear in this file).

# PostStreak backend (poststreak-web). Required: the app throws if it is missing.
EXPO_PUBLIC_API_URL=https://your-backend.example.com

# Supabase project shared with the backend. Required.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
