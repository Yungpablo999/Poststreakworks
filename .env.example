# ============================================================================
# PostStreak — Environment Variables
# Copy to .env.local and fill in real values. Never commit real values.
# ============================================================================

# Supabase (use Supavisor pooled connection string for server-side, NOT direct)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# AI
GROQ_API_KEY=gsk_xxxx
FISH_AUDIO_API_KEY=fish_xxxx

# Payments
PAYSTACK_SECRET_KEY=sk_xxxx
STRIPE_SECRET_KEY=sk_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# Social platform OAuth (LinkedIn: publish_mode='api', X: publish_mode='assisted'
# — X posting itself stays manual copy/confirm, per v1's founder decision;
# OAuth here is only for the "Connect X" identity link, not auto-posting)
LINKEDIN_CLIENT_ID=xxxx
LINKEDIN_CLIENT_SECRET=xxxx
X_CLIENT_ID=xxxx
X_CLIENT_SECRET=xxxx

# Cron security — Vercel Cron sets Authorization: Bearer <secret> on every call
CRON_SECRET=xxxx

# Email
RESEND_API_KEY=re_xxxx

# Sentry
SENTRY_DSN=https://xxx@sentry.io/xxx

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
