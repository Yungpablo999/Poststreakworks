{
  "expo": {
    "name": "Poststreak",
    "slug": "poststreak-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "poststreak",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-dev-client",
        {
          "launchMode": "launcher"
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "PostStreak uses your photos so you can add videos and images to your posts.",
          "cameraPermission": "PostStreak uses your camera so you can film posts without leaving the app.",
          "microphonePermission": "PostStreak uses your microphone to record sound with your videos."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.poststreak.app"
    },
    "android": {
      "package": "com.poststreak.app",
      "adaptiveIcon": {
        "backgroundColor": "#FAF8F5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro",
      "name": "PostStreak",
      "shortName": "PostStreak",
      "themeColor": "#5B3EE8",
      "backgroundColor": "#F7F5F0"
    }
  }
}
