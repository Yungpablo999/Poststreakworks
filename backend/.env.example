# ============================================================================
# PostStreak — Environment Variables
# Copy to .env.local and fill in real values. Never commit real values.
# ============================================================================

# Supabase (use Supavisor pooled connection string for server-side, NOT direct)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# AI
GROQ_API_KEY=gsk_xxxx
FISH_AUDIO_API_KEY=fish_xxxx

# Payments
PAYSTACK_SECRET_KEY=sk_xxxx
STRIPE_SECRET_KEY=sk_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# Social platform OAuth (LinkedIn: publish_mode='api', X: publish_mode='assisted'
# — X posting itself stays manual copy/confirm, per v1's founder decision;
# OAuth here is only for the "Connect X" identity link, not auto-posting)
LINKEDIN_CLIENT_ID=xxxx
LINKEDIN_CLIENT_SECRET=xxxx
X_CLIENT_ID=xxxx
X_CLIENT_SECRET=xxxx

# TikTok (Login Kit + Display API). Use the app's SANDBOX client key/secret on
# staging and the PRODUCTION ones only after TikTok approves the app. The sandbox
# only works for TikTok accounts added as "Target users" in the TikTok portal.
# TIKTOK_REDIRECT_URI must exactly match a redirect URI registered in the TikTok
# app (https only, no query string, no #fragment, max 10), e.g.
#   staging:    https://<your staging app domain>/auth/tiktok/callback
#   production: https://app.poststreak.app/auth/tiktok/callback
TIKTOK_CLIENT_KEY=xxxx
TIKTOK_CLIENT_SECRET=xxxx
TIKTOK_REDIRECT_URI=https://app.example.com/auth/tiktok/callback

# Encrypts platform OAuth tokens before they are stored (AES-256-GCM).
# 32 random bytes, base64. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it in the password vault AND in Vercel; losing it means every creator has
# to reconnect their accounts. To rotate: set the new key here and move the old
# one to TOKEN_ENCRYPTION_KEY_PREVIOUS until tokens have been re-sealed.
TOKEN_ENCRYPTION_KEY=xxxx
# TOKEN_ENCRYPTION_KEY_PREVIOUS=

# Cron security — Vercel Cron sets Authorization: Bearer <secret> on every call
CRON_SECRET=xxxx

# Email
RESEND_API_KEY=re_xxxx

# Sentry
SENTRY_DSN=https://xxx@sentry.io/xxx

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
